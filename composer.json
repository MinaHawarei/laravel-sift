{
    "name": "hawarei/sift",
    "description": "Parse messy tabular text into predictable Laravel Collections.",
    "keywords": [
        "laravel",
        "parser",
        "text",
        "table",
        "clipboard",
        "collection",
        "excel",
        "spreadsheet",
        "tsv",
        "copy-paste"
    ],
    "homepage": "https://github.com/MinaHawarei/laravel-sift",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mina Hawarei",
            "homepage": "https://github.com/MinaHawarei"
        }
    ],
    "support": {
        "issues": "https://github.com/MinaHawarei/laravel-sift/issues",
        "source": "https://github.com/MinaHawarei/laravel-sift"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Hawarei\\Sift\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hawarei\\Sift\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hawarei\\Sift\\SiftServiceProvider"
            ],
            "aliases": {
                "Sift": "Hawarei\\Sift\\Facades\\Sift"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
